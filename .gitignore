# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.envrc
.venv
env/
venv/
ENV/

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# --- Project Specific ---

# 1. Ignore the entire 'old' directory (old models/scripts)
old/

# 2. Ignore datasets and training files
# Ignore all CSV and TXT files in model_dicts (these are the datasets)
model_dicts/*.csv
model_dicts/*.txt
model_dicts/*.xlsx
model_dicts/*.xls

# 3. Handle Model Files
# We want to keep the production models in model_dicts/, but ignore others.
# First, we ignore all large binary model files globally:
*.pt
*.joblib
*.pkl
*.pth

# Then, we specifically UN-IGNORE the models needed for production in model_dicts/
!model_dicts/*.pt
!model_dicts/*.joblib
!model_dicts/*.pkl
!model_dicts/*.pth
!model_dicts/*.p
!model_dicts/*.tsv

# 4. Ignore generated reports and test logs
model_reports/
test.log
